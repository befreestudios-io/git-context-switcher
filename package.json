{
  "name": "git-context-switcher",
  "version": "2.0.0",
  "description": "Per-directory and per-remote git identities (author, SSH key, signing), built on git's native includeIf",
  "type": "module",
  "bin": {
    "git-context": "./index.js"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "files": [
    "index.js",
    "lib/"
  ],
  "scripts": {
    "test": "node --test \"test/**/*.test.js\"",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include=lib/** --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=lcov.info \"test/**/*.test.js\"",
    "lint": "eslint .",
    "typecheck": "tsc -p .",
    "check": "npm run lint && npm run typecheck && npm test",
    "prepublishOnly": "npm run check"
  },
  "keywords": [
    "git",
    "config",
    "identity",
    "includeIf",
    "multi-account",
    "ssh",
    "commit-signing"
  ],
  "author": "Burton Podczerwinski <befreestudios@gmail.com> (https://github.com/befreestudios-io)",
  "license": "MIT",
  "dependencies": {
    "@inquirer/prompts": "^8.7.2",
    "commander": "^15.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.4",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "typescript": "^7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/befreestudios-io/git-context-switcher.git"
  },
  "bugs": {
    "url": "https://github.com/befreestudios-io/git-context-switcher/issues"
  },
  "homepage": "https://github.com/befreestudios-io/git-context-switcher",
  "publishConfig": {
    "access": "public"
  }
}
